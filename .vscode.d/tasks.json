{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Alif: Install M55_HE or M55_HP debug stubs (single core configuration)",
            "detail": "Uses the matching SETOOLS assets already installed under C:\\Alif and programs the selected port",
            "type": "shell",
            "command": [
                "cd '${config:alif.setools.root}';",
                "./app-gen-toc -f 'build/config/${command:cmsis-csolution.getProcessorName}_mram_cfg.json';",
                "./app-write-mram -p ${input:discoverCOM};"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-Command"]
                    }
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Create Python environment (pip)",
            "detail": "Create .venv with the installed Python and pip, then install the model-export dependencies",
            "type": "shell",
            "command": "./model_conversion/setup_venv.sh",
            "windows": {
                "command": ".\\model_conversion\\setup_venv.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Create Python environment (uv)",
            "detail": "Create .venv with uv, optionally downloading the selected Python version; requires uv on PATH",
            "type": "shell",
            "command": "./model_conversion/setup_venv.sh",
            "windows": {
                "command": ".\\model_conversion\\setup_venv.bat"
            },
            "args": ["--uv", "--python", "${input:setupPythonVersion}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Create AI layer",
            "detail": "Export the active solution's declared ML models and write ai_layer (run 'cbuild setup' first)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/model_conversion/create_ai_layer.py",
                "${command:cmsis-csolution.getSolutionDir}/${command:cmsis-csolution.getSolutionName}.cbuild-mlops.yml"
            ],
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "discoverCOM",
            "type": "pickString",
            "description": "Select the SETOOLS serial connection",
            "options": [
                {
                    "label": "Board USB V-Com (COM4)",
                    "value": "-c COM4"
                },
                {
                    "label": "Discover COM ports interactively",
                    "value": "-d"
                },
                {
                    "label": "No - COM port is already selected",
                    "value": ""
                }
            ],
            "default": "-c COM4"
        },
        {
            "id": "setupPythonVersion",
            "type": "promptString",
            "description": "Python version for uv (>=3.10,<3.14), e.g. 3.13 or 3.13.10",
            "default": "3.13"
        }
    ]
}
